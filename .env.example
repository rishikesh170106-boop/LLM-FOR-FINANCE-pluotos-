# Ploutos+ Environment Variables Template
# Copy this file to .env and adjust values if needed

PROJECT_ROOT=.
DATA_DIR=data
RAW_DATA_PATH=data/raw
PROCESSED_DATA_PATH=data/processed

# Hardware & Accelerator
DEVICE=cuda
GPU_ID=0
MAX_VRAM_GB=6.0

